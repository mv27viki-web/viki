<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Toko Online</title>

<style>
* {margin:0;padding:0;box-sizing:border-box;font-family:sans-serif;}
body {background:#f4f4f4;}

header {
  background:#111;color:#fff;padding:15px;
  display:flex;justify-content:space-between;align-items:center;
}

header h1 {color:#00d4ff;}

.container {width:90%;max-width:1100px;margin:auto;}

.grid {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;margin-top:20px;
}

.card {
  background:#fff;padding:15px;border-radius:10px;text-align:center;
}

.card img {width:100%;border-radius:10px;}

button {
  padding:10px;margin-top:10px;
  border:none;background:#00d4ff;color:#fff;
  cursor:pointer;border-radius:5px;
}

button:hover {background:#007cf0;}

.cart {
  position:fixed;
  right:0;top:0;
  width:300px;height:100%;
  background:#fff;
  box-shadow:-5px 0 15px rgba(0,0,0,0.2);
  padding:20px;
  overflow:auto;
}

.cart h2 {margin-bottom:10px;}

.cart-item {
  margin-bottom:10px;
  border-bottom:1px solid #ddd;
  padding-bottom:5px;
}

.checkout {
  background:#25d366;
  width:100%;
}
</style>

</head>
<body>

<header>
  <h1>TokoKu</h1>
  <button onclick="toggleCart()">🛒 Cart (<span id="count">0</span>)</button>
</header>

<div class="container">
  <div class="grid" id="produk"></div>
</div>

<div class="cart" id="cart" style="display:none;">
  <h2>Keranjang</h2>
  <div id="cartItems"></div>
  <h3>Total: Rp <span id="total">0</span></h3>
  <button class="checkout" onclick="checkout()">Checkout WhatsApp</button>
</div>

<script>
let products = [
  {name:"Kaos Keren", price:50000, img:"https://via.placeholder.com/200"},
  {name:"Sepatu Stylish", price:150000, img:"https://via.placeholder.com/200"},
  {name:"Topi Trendy", price:30000, img:"https://via.placeholder.com/200"}
];

let cart = [];

function renderProducts(){
  let html="";
  products.forEach((p,i)=>{
    html+=`
      <div class="card">
        <img src="${p.img}">
        <h3>${p.name}</h3>
        <p>Rp ${p.price}</p>
        <button onclick="addToCart(${i})">Beli</button>
      </div>
    `;
  });
  document.getElementById("produk").innerHTML=html;
}

function addToCart(i){
  cart.push(products[i]);
  updateCart();
}

function updateCart(){
  let html="";
  let total=0;

  cart.forEach((item)=>{
    total+=item.price;
    html+=`<div class="cart-item">${item.name} - Rp ${item.price}</div>`;
  });

  document.getElementById("cartItems").innerHTML=html;
  document.getElementById("total").innerText=total;
  document.getElementById("count").innerText=cart.length;
}

function toggleCart(){
  let c=document.getElementById("cart");
  c.style.display = c.style.display==="none" ? "block":"none";
}

function checkout(){
  let text="Halo, saya mau beli:%0A";
  cart.forEach(item=>{
    text+=`- ${item.name} (Rp ${item.price})%0A`;
  });

  let url=`https://wa.me/6281234567890?text=${text}`;
  window.open(url);
}

renderProducts();
</script>

</body>
</html>
